# Local: docker compose up -d. Producción: la URL de Neon.
DATABASE_URL=postgres://dev:dev@localhost:5432/dashboard

# Login con Google. AUTH_SECRET: `npx auth secret`.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Correos con acceso, separados por coma. Sin esta variable no entra nadie.
# (AUTH_ALLOWED_EMAIL, de un solo correo, sigue valiendo si esta no está.)
AUTH_ALLOWED_EMAILS=
